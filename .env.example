# Desktop client settings. The application intentionally does not load this file itself.
RESOLVEAI_API_BASE_URL=http://localhost:8080/api

# Optional OpenAI-compatible chat completions provider (AI suggestions are requested by the desktop client).
# Leave RESOLVEAI_AI_API_KEY unset to use the local heuristic fallback.
RESOLVEAI_AI_API_KEY=
RESOLVEAI_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
RESOLVEAI_AI_MODEL=gpt-4o-mini